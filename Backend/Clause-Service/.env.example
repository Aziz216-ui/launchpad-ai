PORT=3004
NODE_ENV=development
GLOBAL_PREFIX=api/clauses

# Database (base dédiée au service)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clause_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Netflix Eureka Service Discovery
EUREKA_ENABLED=true
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_SERVICE_PATH=/eureka/apps/
EUREKA_APP_NAME=CLAUSE-SERVICE
EUREKA_CLIENT_HOST=localhost
EUREKA_CLIENT_IP=127.0.0.1

# RabbitMQ (messagerie asynchrone entre microservices)
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=launchpad.events
