# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=votre-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Base de donnees PostgreSQL ────────────────────────────────────────────────
# PostgreSQL est requis (SQLite n'est pas supporte en production)
DB_NAME=projet_db
DB_USER=projet_user
DB_PASSWORD=projet_password
DB_HOST=localhost
DB_PORT=5445

# ── Eureka ────────────────────────────────────────────────────────────────────
EUREKA_SERVER=http://localhost:8761/eureka/
APP_NAME=projet-service
APP_PORT=8006
# HOST_IP : IP joignable depuis les autres services (laisser vide = detection auto)
HOST_IP=

# ── ETUDE-SERVICE (Étude de marché) ───────────────────────────────────────────
MARKET_SERVICE_NAME=ETUDE-SERVICE
MARKET_SERVICE_URL=http://localhost:8090

# ── CORS (production uniquement, ignore si DEBUG=True) ────────────────────────
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://monapp.com

# ── LLM (optionnel — repli automatique sur les regles si LLM_API_KEY est vide) ──
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=market
RABBITMQ_PASSWORD=market
RABBITMQ_EXCHANGE=ai.events
MARKET_RABBITMQ_EXCHANGE=market.events


