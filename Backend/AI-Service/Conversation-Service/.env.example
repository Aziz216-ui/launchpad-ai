# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=votre-cle-secrete-conversation
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Base de donnees PostgreSQL ────────────────────────────────────────────────
DB_NAME=conversation_db
DB_USER=conversation_user
DB_PASSWORD=conversation_password
DB_HOST=localhost
DB_PORT=5436

# ── Eureka ────────────────────────────────────────────────────────────────────
EUREKA_SERVER=http://localhost:8761/eureka/
APP_NAME=conversation-service
APP_PORT=8008
HOST_IP=

# ── Services inter-connectes ──────────────────────────────────────────────────
PROJET_SERVICE_NAME=projet-service
PROJET_SERVICE_URL=http://localhost:8006
MARKET_SERVICE_NAME=market-service
MARKET_SERVICE_URL=http://localhost:8005

# ── LLM (optionnel) ───────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

