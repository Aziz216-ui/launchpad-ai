# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=votre-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Base de donnees PostgreSQL ────────────────────────────────────────────────
# PostgreSQL est requis (SQLite n'est pas supporte en production)
DB_NAME=cofondateur_db
DB_USER=cofondateur_user
DB_PASSWORD=cofondateur_password
DB_HOST=localhost
DB_PORT=5434

# ── Eureka ────────────────────────────────────────────────────────────────────
EUREKA_SERVER=http://localhost:8761/eureka/
APP_NAME=ai-service
APP_PORT=8006
# HOST_IP : IP joignable depuis les autres services (laisser vide = detection auto)
HOST_IP=

# ── Market-Service ────────────────────────────────────────────────────────────
MARKET_SERVICE_NAME=market-service
MARKET_SERVICE_URL=http://localhost:8005

# ── CORS (production uniquement, ignore si DEBUG=True) ────────────────────────
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://monapp.com

# ── LLM (optionnel — repli automatique sur les regles si LLM_API_KEY est vide) ──
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
