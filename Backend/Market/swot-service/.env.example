# Copier ce fichier en .env puis adapter les valeurs (ne jamais commiter .env)
SECRET_KEY=changez-moi-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,swot-service

# PostgreSQL (base dédiée au service)
DB_NAME=swot_db
DB_USER=swot_user
DB_PASSWORD=swot_password
DB_HOST=localhost
DB_PORT=5443

# Origines autorisées par CORS (frontend Angular), séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Origines de confiance pour le CSRF (POST via la gateway avec une session admin active)
CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://localhost:4200,http://localhost:8013

# Eureka (Backend/Eureka, port 8761) : enregistrement sous SWOT-SERVICE, port 8013,
# et résolution des services appelés par leur nom Eureka.
# En Docker, docker-compose.yml remplace l'URL par http://host.docker.internal:8761/eureka/
EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOST=localhost
# En Docker uniquement : alias de "localhost" pour joindre les autres services
EUREKA_LOCALHOST_ALIAS=

# Services appelés : URL directe si Eureka est désactivé ou ne connaît pas le service
ETUDE_SERVICE_URL=http://localhost:8012
