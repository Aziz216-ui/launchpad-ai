# Variables de l'environnement de test (aucun secret réel)
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Keycloak simulé (voir tests/Security/KeycloakMockResponseFactory.php) : aucun serveur réel n'est contacté
KEYCLOAK_BASE_URL=http://keycloak.test
KEYCLOAK_USE_CLIENT_ROLES=false

# Fichiers déposés pendant les tests, séparés des fichiers de développement
DOCUMENT_STORAGE_DIR=%kernel.project_dir%/var/uploads_test
