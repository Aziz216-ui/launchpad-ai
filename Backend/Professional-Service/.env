# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# À définir dans .env.local (jamais commité)
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# Serveur de développement (composer serve)
APP_HOST=127.0.0.1
APP_PORT=8085

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
# Expression régulière des origines autorisées (Angular en dev : http://localhost:4200)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> keycloak ###
# Le jeton (Authorization: Bearer) est validé localement : signature (JWKS), exp, iss et aud
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=launchpad
KEYCLOAK_CLIENT_ID=launchpad-app
# Émetteur attendu (claim "iss") ; doit correspondre exactement à l'URL publique de Keycloak
KEYCLOAK_ISSUER=${KEYCLOAK_BASE_URL}/realms/${KEYCLOAK_REALM}
# Audience attendue (claim "aud"), ajoutée par un Audience mapper côté Keycloak
KEYCLOAK_AUDIENCE=${KEYCLOAK_CLIENT_ID}
# true : lit aussi resource_access.<KEYCLOAK_CLIENT_ID>.roles (rôles de client)
KEYCLOAK_USE_CLIENT_ROLES=false
# Noms des rôles Keycloak -> ROLE_ACCOUNTANT / ROLE_ENTREPRENEUR / ROLE_ADMIN
KEYCLOAK_ROLE_ACCOUNTANT=ACCOUNTANT
KEYCLOAK_ROLE_ENTREPRENEUR=ENTREPRENEUR
KEYCLOAK_ROLE_ADMIN=ADMIN
###< keycloak ###

###> documents ###
# Répertoire privé des fichiers déposés (jamais servi publiquement)
DOCUMENT_STORAGE_DIR=%kernel.project_dir%/var/uploads
DOCUMENT_MAX_SIZE=10M
###< documents ###

###> eureka ###
# true : "composer serve" enregistre aussi le service dans Eureka (app:eureka:register)
EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka
# Nom utilisé par la Gateway : lb://PROFESSIONAL-SERVICE
EUREKA_APP_NAME=PROFESSIONAL-SERVICE
# Adresse à laquelle la Gateway joint ce service (port = APP_PORT)
EUREKA_INSTANCE_HOST=localhost
EUREKA_INSTANCE_IP=127.0.0.1
EUREKA_HEARTBEAT_INTERVAL=30
###< eureka ###

###> doctrine/doctrine-bundle ###
# Valeur d'exemple : mettez vos vrais identifiants dans .env.local
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/accounting_db?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
