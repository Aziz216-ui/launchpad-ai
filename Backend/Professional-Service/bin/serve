#!/usr/bin/env php
<?php

/*
 * Lance le serveur de développement PHP intégré sur le port défini par APP_PORT
 * (lu depuis .env / .env.local, 8085 par défaut).
 * Usage : composer serve   ou   php bin/serve
 */

use Symfony\Component\Dotenv\Dotenv;

$projectDir = dirname(__DIR__);

require $projectDir.'/vendor/autoload.php';

(new Dotenv())->bootEnv($projectDir.'/.env');

$host = $_SERVER['APP_HOST'] ?? '127.0.0.1';
$port = (int) ($_SERVER['APP_PORT'] ?? 8085);

if ($port < 1 || $port > 65535) {
    fwrite(STDERR, "APP_PORT invalide : {$port}\n");
    exit(1);
}

echo "Service comptable disponible sur http://{$host}:{$port}/api/comptable\n";

// Enregistrement Eureka en parallèle du serveur (EUREKA_ENABLED=true)
$eureka = null;
if (filter_var($_SERVER['EUREKA_ENABLED'] ?? false, FILTER_VALIDATE_BOOL)) {
    echo "Enregistrement dans Eureka ({$_SERVER['EUREKA_SERVER_URL']}) sous {$_SERVER['EUREKA_APP_NAME']}\n";
    $eureka = proc_open([PHP_BINARY, $projectDir.'/bin/console', 'app:eureka:register'], [STDIN, STDOUT, STDERR], $pipes, $projectDir);
}

passthru(sprintf(
    '%s -S %s -t %s',
    escapeshellarg(PHP_BINARY),
    escapeshellarg("{$host}:{$port}"),
    escapeshellarg($projectDir.'/public'),
), $exitCode);

if (\is_resource($eureka)) {
    // Ctrl+C est aussi reçu par la commande Eureka, qui se désinscrit avant de s'arrêter
    proc_close($eureka);
}

exit($exitCode);
