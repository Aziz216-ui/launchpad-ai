# Prevision-Service (port 8081, base prevision_db)
DB_URL=jdbc:postgresql://localhost:5432/prevision_db
DB_USERNAME=prevision
DB_PASSWORD=prevision
SERVER_PORT=8081
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Document-Service appelé par l'assistant financier : résolu via Eureka, repli sur cette URL (ou l'API Gateway).
DOCUMENT_SERVICE_NOM=document-service
DOCUMENT_SERVICE_URL=http://localhost:8082

# IA désactivée par défaut. Pour activer Grok (xAI) : SPRING_AI_MODEL_CHAT=openai et XAI_API_KEY.
SPRING_AI_MODEL_CHAT=none
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
XAI_MODEL=grok-4
