# Document-Service (port 8082, base document_db)
DB_URL=jdbc:postgresql://localhost:5432/document_db
DB_USERNAME=document
DB_PASSWORD=document
SERVER_PORT=8082
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Prevision-Service (prévisions, marges, IA) : résolu via Eureka, repli sur cette URL (ou l'API Gateway).
PREVISION_SERVICE_NOM=prevision-service
PREVISION_SERVICE_URL=http://localhost:8081

# RabbitMQ (événement « document généré »)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Stockage des fichiers exportés : disque local en profil dev, S3 / MinIO sinon.
STOCKAGE_LOCAL_REPERTOIRE=./data/documents
STOCKAGE_OBJET_ENDPOINT=http://localhost:9000
STOCKAGE_OBJET_BUCKET=finance-documents
STOCKAGE_OBJET_ACCESS_KEY=
STOCKAGE_OBJET_SECRET_KEY=
