PORT=3003
NODE_ENV=development
GLOBAL_PREFIX=api/legal

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=legal_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Netflix Eureka Service Discovery
EUREKA_ENABLED=true
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_SERVICE_PATH=/eureka/apps/
EUREKA_APP_NAME=LEGAL-SERVICE
EUREKA_CLIENT_HOST=localhost
EUREKA_CLIENT_IP=127.0.0.1

# Microservices appelés par le Legal-Service
CLAUSE_SERVICE_URL=http://localhost:3004/api/clauses
COMMENTAIRE_SERVICE_URL=http://localhost:3005/api/commentaires
