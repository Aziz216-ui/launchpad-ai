# Copier ce fichier en .env et renseigner de vraies valeurs. Ne jamais committer .env.

# Django
DEBUG=False
SECRET_KEY=changeme-generate-a-real-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL ("launchpad" db, voir docker-compose.yml)
DB_NAME=launchpad
DB_USER=app_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8180/
KEYCLOAK_REALM=launchpad
KEYCLOAK_CLIENT_ID=launchpad-client
KEYCLOAK_CLIENT_SECRET=changeme-must-match-the-launchpad-client-secret-in-keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Comptes de démo (seed_demo_users au démarrage du conteneur) : vide = mots de passe de démo du code
SEED_DEMO_USERS=true
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
DEMO_ACCOUNTANT_PASSWORD=
DEMO_LAWYER_PASSWORD=

# Keycloak's own PostgreSQL database (docker-compose.yml only)
KEYCLOAK_DB_PASSWORD=changeme

# Ports hôte (docker-compose.yml), tous optionnels
# USER_DB_PORT=5439
# KEYCLOAK_PORT=8180
# USER_SERVICE_PORT=8001

# Eureka
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost
EUREKA_ENABLED=True
