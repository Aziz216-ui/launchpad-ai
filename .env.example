# Copier en .env pour surcharger les valeurs de démonstration de docker-compose.yml.
# Tout est facultatif : sans .env, la plateforme démarre avec les valeurs par défaut.

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=launchpad-dev-client-secret
KEYCLOAK_DB_PASSWORD=keycloak
# KEYCLOAK_PORT=8180

# RabbitMQ (un seul broker pour toute la plateforme)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RABBITMQ_MGMT_PORT=15672

# Secrets applicatifs
DJANGO_SECRET_KEY=launchpad-dev-secret-key-change-me
MARKET_DB_PASSWORD=market-db-pass
COMPTA_DB_PASSWORD=compta-root-pass
COMPTA_APP_SECRET=0123456789abcdef0123456789abcdef
INTERNAL_API_KEY=launchpad-dev-internal-key

# Fournisseurs IA (facultatif)
# LLM_API_KEY=

# IA du module Finance (Prevision-Service) : analyse des documents, commentaire de l'écart, assistant.
# Sans ces lignes, l'IA est désactivée (ces fonctions répondent 503, le reste du module fonctionne).
# Fournisseur compatible OpenAI : xAI (défaut) ou Groq. Ne jamais committer le .env (il contient la clé).
# SPRING_AI_MODEL_CHAT=openai
# XAI_API_KEY=
# Groq :
# XAI_BASE_URL=https://api.groq.com/openai
# XAI_MODEL=qwen/qwen3.8-27b
# xAI (défaut si les deux lignes ci-dessus sont absentes) : https://api.x.ai, modèle grok-4
