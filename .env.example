# Copier en .env pour surcharger les valeurs de démonstration de docker-compose.yml.
# Tout est facultatif : sans .env, la plateforme démarre avec les valeurs par défaut.

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_SECRET=launchpad-dev-client-secret
KEYCLOAK_DB_PASSWORD=keycloak
# KEYCLOAK_PORT=8180

# RabbitMQ (un seul broker pour toute la plateforme)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RABBITMQ_MGMT_PORT=15672

# Secrets applicatifs
DJANGO_SECRET_KEY=launchpad-dev-secret-key-change-me
MARKET_DB_PASSWORD=market-db-pass
COMPTA_DB_PASSWORD=compta-root-pass
COMPTA_APP_SECRET=0123456789abcdef0123456789abcdef
INTERNAL_API_KEY=launchpad-dev-internal-key

# E-mails du User-Service (code « Mot de passe oublié »). Facultatif : sans EMAIL_HOST, les
# e-mails arrivent dans Mailpit (http://localhost:8025), aucun n'est réellement envoyé.
# Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True, EMAIL_HOST_USER = l'adresse
# Gmail, EMAIL_HOST_PASSWORD = un « mot de passe d'application » Google (16 caractères, compte avec
# validation en 2 étapes), DEFAULT_FROM_EMAIL = la même adresse Gmail. Ne jamais committer le .env.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Fournisseurs IA (facultatif)
# LLM_API_KEY=
# XAI_API_KEY=
